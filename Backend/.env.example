# Copia este archivo como .env y ajusta los valores

PORT=3000
# development o production (en production la cookie de sesión exige HTTPS)
NODE_ENV=development
# Origen del frontend (Vite) al que se le permite llamar a la API
CORS_ORIGIN=http://localhost:5173

# Opción A: una sola cadena de conexión (la que entregan Aiven, Railway, etc.)
# DATABASE_URL=mysql://usuario:clave@host:puerto/base
# Opción B: datos por separado
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=rinconbd2
# Conexión cifrada (obligatoria en MySQL alojados). DB_SSL_CA: certificado CA en texto PEM
# DB_SSL=true
# DB_SSL_CA=

# Producción detrás de proxies: saltos entre el usuario y la app (Vercel + Render = 2)
# TRUST_PROXY=2

# Cadena larga y aleatoria; no la subas a git. Obligatoria en production.
# Genera una con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cambia-este-secreto

# lax si frontend y backend están en el mismo dominio (ej. app.midominio.cl y api.midominio.cl).
# none si están en dominios distintos (requiere HTTPS).
COOKIE_SAMESITE=lax
